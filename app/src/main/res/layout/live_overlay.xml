<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Top: LIVE badge, channel, program, and the clock with Audio & Subtitles under it. -->
    <LinearLayout
        android:id="@+id/live_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/live_top_scrim"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/live_badge_bg"
            android:letterSpacing="0.08"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/live"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/live_program"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/live_tracks"
                style="@style/RoundButton"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/audio_and_subtitles"
                android:src="@drawable/ic_tracks" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: program progress, then the big Guide button and recent channels. -->
    <LinearLayout
        android:id="@+id/live_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#C705080C"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/live_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/live_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/live_progress" />

            <TextView
                android:id="@+id/live_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/live_guide"
                android:layout_width="150dp"
                android:layout_height="104dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:contentDescription="@string/guide"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_guide"
                    android:tint="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/guide"
                    android:textColor="@color/text"
                    android:textSize="17sp" />
            </LinearLayout>

            <Button
                android:id="@+id/live_jump"
                style="@style/PillButton"
                android:layout_marginEnd="14dp"
                android:drawableStart="@drawable/live_dot"
                android:text="@string/jump_to_live"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/live_recents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- What's playing (codec, size, frame rate, scan, audio), for troubleshooting. -->
        <TextView
            android:id="@+id/live_stream_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#B3C3D2DB"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/live_hint"
            android:textColor="#8FA3AE"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
