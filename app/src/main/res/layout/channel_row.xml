<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/ch_number"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/row_detail"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ch_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/row_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ch_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/row_detail"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ch_next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="0.8"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/row_detail"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:id="@+id/ch_playing"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/live_dot"
        android:visibility="invisible" />
</LinearLayout>
